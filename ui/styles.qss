/* Ctrans Glassmorphism Dark QSS Theme */

QWidget {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #cdd6f4;
    background: transparent;
    selection-background-color: rgba(137, 180, 250, 0.35);
    selection-color: #ffffff;
}

/* Parent container: fully transparent with zero outer box/border */
#CentralContainer {
    background: transparent;
    border: none;
}

/* Single Standalone Floating Input Bar */
QLineEdit#InputBar {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 10px 18px;
    font-size: 13pt;
    color: #cdd6f4;
    selection-background-color: rgba(137, 180, 250, 0.35);
    selection-color: #ffffff;
}

QLineEdit#InputBar:focus {
    border: 1px solid rgba(255, 255, 255, 0.45);
    background-color: rgba(28, 28, 30, 0.95);
}

/* Completer Popup Dropdown */
QListView#CompleterPopup {
    background-color: rgba(28, 28, 30, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    padding: 6px;
    color: #cdd6f4;
    font-size: 12pt;
    outline: none;
}

QListView#CompleterPopup::item {
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
}

QListView#CompleterPopup::item:selected,
QListView#CompleterPopup::item:hover {
    background-color: rgba(137, 180, 250, 0.20);
    color: #89b4fa;
    border: 1px solid rgba(137, 180, 250, 0.35);
}

/* Loading State Capsule */
#LoadingWidget {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
}

#LoadingLabel {
    color: #89b4fa;
    font-size: 13pt;
    font-weight: 500;
}

/* Result View Capsule */
#ResultViewWidget {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
}

/* Result View Header */
#HeaderBar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

#BadgeLabel {
    color: #89b4fa;
    font-size: 10pt;
    font-weight: 600;
    padding: 3px 8px;
    background-color: rgba(137, 180, 250, 0.15);
    border: 1px solid rgba(137, 180, 250, 0.25);
    border-radius: 6px;
}

#CopyButton {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #cdd6f4;
    font-size: 10pt;
    padding: 4px 12px;
}

#CopyButton:hover {
    background-color: rgba(137, 180, 250, 0.20);
    border-color: #89b4fa;
    color: #89b4fa;
}

#CopyButton:pressed {
    background-color: rgba(137, 180, 250, 0.35);
}

/* Markdown Text Browser */
QTextBrowser#ResultText {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 13pt;
    line-height: 1.6;
    padding: 4px 2px;
}

/* Stealth Slim Glassmorphic Scrollbar (invisible until hovered) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: transparent;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar:vertical:hover QScrollBar::handle:vertical,
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.25);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(137, 180, 250, 0.50);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}
