# ==============================================================================
# API Configuration for CAsk (Universal Quick AI Assistant)
# Copy this file to ~/.config/cask/config.env or .env in this folder
# Or configure interactively via the In-HUD Settings Gear Button [Ctrl+,]
#
# NOTE: The Settings HUD now saves model cards to ~/.config/cask/models.json.
# When models.json exists, it takes priority over the legacy env vars below.
# These env vars remain as a fallback and are synced on Settings save.
# ==============================================================================

# 0. Active Provider Pipeline (Order of priority: primary, fallback 1, fallback 2...)
# Available provider IDs: groq, gemini, custom_openai
PROVIDER_ORDER="groq,gemini"

# 1. Groq Cloud (Recommended - Blazing fast ~0.6s, Free: https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# 2. Google Gemini API (Fallback, Free: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-lite-latest"

# 3. 9Router / Local Gateway / OpenAI-Compatible (Optional: http://localhost:20128/v1)
CUSTOM_OPENAI_BASE_URL="http://localhost:20128/v1"
CUSTOM_OPENAI_API_KEY="your_local_or_custom_key_here"
CUSTOM_OPENAI_MODEL="claude-3-5-sonnet"

# 4. Output Generation Limits (Optional)
MAX_TOKENS=4096

# 5. Multi-Turn Follow-Up Limit (Optional, Default: 3, Min: 1, Max: 10)
MAX_FOLLOWUP_TURNS=3

