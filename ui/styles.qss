/* CAsk Glassmorphism Theme (#1b1f26 Translucent Capsules) */

QWidget {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    color: #e6ebf5;
    background: transparent;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

/* Parent container: fully transparent with zero outer box/border */
#CentralContainer {
    background: transparent;
    border: none;
}

/* Foreground UI Windows: Glass Capsules with #1b1f26 semi-transparent background */
#InputBar {
    background-color: rgba(27, 31, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
    padding: 10px 18px;
    font-size: 12pt;
    color: #e6ebf5;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

#InputBar:focus {
    border: 1px solid rgba(137, 180, 250, 0.70);
    border-top: 1px solid rgba(255, 255, 255, 0.50);
    background-color: rgba(35, 41, 52, 0.85);
}

/* Completer Popup Dropdown */
QListView#CompleterPopup {
    background-color: rgba(27, 31, 38, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    padding: 6px;
    color: #e6ebf5;
    font-size: 11pt;
    outline: none;
}

QListView#CompleterPopup QWidget {
    background: transparent;
}

QListView#CompleterPopup::item {
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
    color: #f9e2af;
    font-weight: bold;
}

QListView#CompleterPopup::item:selected,
QListView#CompleterPopup::item:hover {
    background-color: rgba(249, 226, 175, 0.22);
    color: #f9e2af;
    border: 1px solid rgba(249, 226, 175, 0.40);
}

/* Loading State Glass Capsule */
#LoadingWidget {
    background-color: rgba(27, 31, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
}

#LoadingLabel {
    color: #e6ebf5;
    font-size: 12pt;
    font-weight: 500;
}

/* Result View Glass Capsule */
#ResultViewWidget {
    background-color: rgba(27, 31, 38, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
}

/* Result View Header */
#HeaderBar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

#BadgeLabel {
    color: #89b4fa;
    font-size: 10pt;
    font-weight: 600;
    padding: 3px 8px;
    background-color: rgba(137, 180, 250, 0.18);
    border: 1px solid rgba(137, 180, 250, 0.32);
    border-radius: 6px;
}

#SearchButton,
#CopyButton,
#PinButton,
#ExitButton,
#CloseButton {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: #e6ebf5;
    font-size: 10pt;
    padding: 4px 10px;
    qproperty-iconSize: 14px 14px;
}

#SearchButton:hover,
#CopyButton:hover {
    background-color: rgba(137, 180, 250, 0.25);
    border-color: #89b4fa;
    color: #ffffff;
}

#SearchButton:pressed,
#CopyButton:pressed {
    background-color: rgba(137, 180, 250, 0.40);
}

#PinButton:hover {
    background-color: rgba(249, 226, 175, 0.20);
    border-color: #f9e2af;
    color: #f9e2af;
}

#PinButton[pinned="true"] {
    background-color: rgba(249, 226, 175, 0.28);
    border: 1px solid rgba(249, 226, 175, 0.65);
    color: #f9e2af;
    font-weight: bold;
}

#ExitButton:hover,
#CloseButton:hover {
    background-color: rgba(248, 113, 113, 0.25);
    border-color: #f87171;
    color: #ffffff;
}

#ExitButton:pressed,
#CloseButton:pressed {
    background-color: rgba(248, 113, 113, 0.45);
}

/* Markdown Text Browser */
QTextBrowser#ResultText {
    background-color: transparent;
    border: none;
    color: #e6ebf5;
    font-size: 12pt;
    line-height: 1.6;
    padding: 4px 2px;
}

/* Modern Slim Gray Scrollbar */
QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.04);
    width: 5px;
    margin: 4px 2px 4px 0px;
    border-radius: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    min-height: 28px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(249, 226, 175, 0.65);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}
