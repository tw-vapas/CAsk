/* CAsk Glassmorphism Theme with #3F4B65 Capsule Panels */

QWidget {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    color: #e6ebf5;
    background: transparent;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

/* Parent container: fully transparent with zero outer box/border */
#CentralContainer {
    background: transparent;
    border: none;
}

/* Foreground UI Windows: Glass Capsules with #3F4B65 semi-transparent background */
#InputBar {
    background-color: rgba(63, 75, 101, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 14px;
    padding: 10px 18px;
    font-size: 12pt;
    color: #e6ebf5;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

#InputBar:focus {
    border: 1px solid rgba(137, 180, 250, 0.70);
    border-top: 1px solid rgba(255, 255, 255, 0.55);
    background-color: rgba(75, 89, 120, 0.78);
}

/* Completer Popup Dropdown */
QListView#CompleterPopup {
    background-color: rgba(55, 66, 90, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.40);
    border-radius: 12px;
    padding: 6px;
    color: #e6ebf5;
    font-size: 11pt;
    outline: none;
}

QListView#CompleterPopup::item {
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
    color: #f9e2af;
    font-weight: bold;
}

QListView#CompleterPopup::item:selected,
QListView#CompleterPopup::item:hover {
    background-color: rgba(249, 226, 175, 0.25);
    color: #f9e2af;
    border: 1px solid rgba(249, 226, 175, 0.45);
}

/* Loading State Glass Capsule */
#LoadingWidget {
    background-color: rgba(63, 75, 101, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 14px;
}

#LoadingLabel {
    color: #e6ebf5;
    font-size: 12pt;
    font-weight: 500;
}

/* Result View Glass Capsule */
#ResultViewWidget {
    background-color: rgba(63, 75, 101, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 14px;
}

/* Result View Header */
#HeaderBar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

#BadgeLabel {
    color: #89b4fa;
    font-size: 10pt;
    font-weight: 600;
    padding: 3px 8px;
    background-color: rgba(137, 180, 250, 0.22);
    border: 1px solid rgba(137, 180, 250, 0.38);
    border-radius: 6px;
}

#CopyButton {
    background-color: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #e6ebf5;
    font-size: 10pt;
    padding: 4px 12px;
}

#CopyButton:hover {
    background-color: rgba(137, 180, 250, 0.30);
    border-color: #89b4fa;
    color: #ffffff;
}

#CopyButton:pressed {
    background-color: rgba(137, 180, 250, 0.45);
}

/* Markdown Text Browser */
QTextBrowser#ResultText {
    background-color: transparent;
    border: none;
    color: #e6ebf5;
    font-size: 12pt;
    line-height: 1.6;
    padding: 4px 2px;
}

/* Modern Slim Gray Scrollbar */
QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.05);
    width: 5px;
    margin: 4px 2px 4px 0px;
    border-radius: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.30);
    min-height: 28px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.50);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(249, 226, 175, 0.65);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}
