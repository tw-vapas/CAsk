/* CAsk Glassmorphism Dark QSS Theme */

QWidget {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    color: #dcdfe7;
    background: transparent;
    selection-background-color: rgba(137, 180, 250, 0.35);
    selection-color: #ffffff;
}

/* Parent container: fully transparent with zero outer box/border */
#CentralContainer {
    background: transparent;
    border: none;
}

/* Single Standalone Floating Input Bar */
#InputBar {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 10px 18px;
    font-size: 12pt;
    color: #dcdfe7;
    selection-background-color: rgba(137, 180, 250, 0.35);
    selection-color: #ffffff;
}

#InputBar:focus {
    border: 1px solid rgba(255, 255, 255, 0.45);
    background-color: rgba(28, 28, 30, 0.95);
}

/* Completer Popup Dropdown */
QListView#CompleterPopup {
    background-color: rgba(28, 28, 30, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    padding: 6px;
    color: #dcdfe7;
    font-size: 11pt;
    outline: none;
}

QListView#CompleterPopup::item {
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
    color: #f9e2af;
    font-weight: bold;
}

QListView#CompleterPopup::item:selected,
QListView#CompleterPopup::item:hover {
    background-color: rgba(249, 226, 175, 0.18);
    color: #f9e2af;
    border: 1px solid rgba(249, 226, 175, 0.35);
}

/* Loading State Capsule */
#LoadingWidget {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
}

#LoadingLabel {
    color: #dcdfe7;
    font-size: 12pt;
    font-weight: 500;
}

/* Result View Capsule */
#ResultViewWidget {
    background-color: rgba(28, 28, 30, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
}

/* Result View Header */
#HeaderBar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

#BadgeLabel {
    color: #89b4fa;
    font-size: 10pt;
    font-weight: 600;
    padding: 3px 8px;
    background-color: rgba(137, 180, 250, 0.15);
    border: 1px solid rgba(137, 180, 250, 0.25);
    border-radius: 6px;
}

#CopyButton {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #dcdfe7;
    font-size: 10pt;
    padding: 4px 12px;
}

#CopyButton:hover {
    background-color: rgba(137, 180, 250, 0.20);
    border-color: #89b4fa;
    color: #89b4fa;
}

#CopyButton:pressed {
    background-color: rgba(137, 180, 250, 0.35);
}

/* Markdown Text Browser */
QTextBrowser#ResultText {
    background-color: transparent;
    border: none;
    color: #dcdfe7;
    font-size: 12pt;
    line-height: 1.6;
    padding: 4px 2px;
}

/* Modern Slim Gray Scrollbar */
QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.03);
    width: 5px;
    margin: 4px 2px 4px 0px;
    border-radius: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.22);
    min-height: 28px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.40);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(249, 226, 175, 0.60);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}
