/* CAsk Glassmorphism Theme (#1b1f26 Translucent Capsules) */

QWidget {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    color: #e6ebf5;
    background: transparent;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

/* Parent container: fully transparent with zero outer box/border */
#CentralContainer {
    background: transparent;
    border: none;
}

/* Foreground UI Windows: Glass Capsules with #1b1f26 semi-transparent background */
#InputBar {
    background-color: rgba(27, 31, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
    padding: 10px 42px 10px 18px;
    font-size: 12pt;
    color: #e6ebf5;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

#InputBar:focus {
    border: 1px solid rgba(137, 180, 250, 0.70);
    border-top: 1px solid rgba(255, 255, 255, 0.50);
    background-color: rgba(35, 41, 52, 0.85);
}

/* Completer Popup Dropdown */
QListView#CompleterPopup {
    background-color: rgba(27, 31, 38, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    padding: 6px;
    color: #e6ebf5;
    font-size: 11pt;
    outline: none;
}

QListView#CompleterPopup QWidget {
    background: transparent;
}

QListView#CompleterPopup::item {
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
    color: #f9e2af;
    font-weight: bold;
}

QListView#CompleterPopup::item:selected,
QListView#CompleterPopup::item:hover {
    background-color: rgba(249, 226, 175, 0.22);
    color: #f9e2af;
    border: 1px solid rgba(249, 226, 175, 0.40);
}

/* Loading State Glass Capsule */
#LoadingWidget {
    background-color: rgba(27, 31, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
}

#LoadingLabel {
    color: #e6ebf5;
    font-size: 12pt;
    font-weight: 500;
}

/* Result View Glass Capsule */
#ResultViewWidget {
    background-color: rgba(27, 31, 38, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 14px;
}

/* Result View Header */
#HeaderBar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

#BadgeLabel {
    color: #89b4fa;
    font-size: 10pt;
    font-weight: 600;
    padding: 3px 8px;
    background-color: rgba(137, 180, 250, 0.18);
    border: 1px solid rgba(137, 180, 250, 0.32);
    border-radius: 6px;
}

#DragHandle {
    background: transparent;
    border: none;
    padding: 2px 4px;
    qproperty-iconSize: 14px 14px;
}

#DragHandle:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
}

#DropGhostIndicator {
    background-color: rgba(137, 180, 250, 0.15);
    border: 2px dashed rgba(137, 180, 250, 0.70);
    border-radius: 14px;
}

#AskButton,
#SearchButton,
#CopyButton,
#PinButton,
#ExitButton,
#CloseButton {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: #e6ebf5;
    font-size: 10pt;
    padding: 4px 10px;
    qproperty-iconSize: 14px 14px;
}

#AskButton:hover,
#SearchButton:hover,
#CopyButton:hover {
    background-color: rgba(137, 180, 250, 0.25);
    border-color: #89b4fa;
    color: #ffffff;
}

#AskButton:pressed,
#SearchButton:pressed,
#CopyButton:pressed {
    background-color: rgba(137, 180, 250, 0.40);
}

#PinButton:hover {
    background-color: rgba(249, 226, 175, 0.20);
    border-color: #f9e2af;
    color: #f9e2af;
}

#PinButton[pinned="true"] {
    background-color: rgba(249, 226, 175, 0.28);
    border: 1px solid rgba(249, 226, 175, 0.65);
    color: #f9e2af;
    font-weight: bold;
}

#ExitButton:hover,
#CloseButton:hover {
    background-color: rgba(248, 113, 113, 0.25);
    border-color: #f87171;
    color: #ffffff;
}

#ExitButton:pressed,
#CloseButton:pressed {
    background-color: rgba(248, 113, 113, 0.45);
}

/* Markdown Text Browser */
QTextBrowser#ResultText {
    background-color: transparent;
    border: none;
    color: #e6ebf5;
    font-size: 12pt;
    line-height: 1.6;
    padding: 4px 2px;
}

/* Modern Slim Gray Scrollbar */
QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.04);
    width: 5px;
    margin: 4px 2px 4px 0px;
    border-radius: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    min-height: 28px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(249, 226, 175, 0.65);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

/* Multi-turn Follow-up Footer Bar */
#FollowUpFooter {
    background: transparent;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-top: 8px;
    margin-top: 4px;
}

#FollowUpInput {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11pt;
    color: #e6ebf5;
    selection-background-color: rgba(137, 180, 250, 0.40);
    selection-color: #ffffff;
}

#FollowUpInput:focus {
    border: 1px solid rgba(137, 180, 250, 0.65);
    background-color: rgba(35, 41, 52, 0.80);
}

#FollowUpInput[is_command="true"] {
    border: 1px solid rgba(249, 226, 175, 0.65);
    color: #f9e2af;
}

#FollowUpInput:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(230, 235, 245, 0.40);
}

#TurnBadge {
    color: #89b4fa;
    font-size: 9pt;
    font-weight: 600;
    padding: 4px 8px;
    background-color: rgba(137, 180, 250, 0.15);
    border: 1px solid rgba(137, 180, 250, 0.28);
    border-radius: 6px;
}

#TurnBadge[limit_reached="true"] {
    color: #f9e2af;
    background-color: rgba(249, 226, 175, 0.18);
    border: 1px solid rgba(249, 226, 175, 0.40);
}

/* Settings Button inside InputBar */
QToolButton#SettingsButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}

QToolButton#SettingsButton:hover {
    background: rgba(249, 226, 175, 0.20);
}

/* Settings View HUD */
#SettingsView {
    background: transparent;
}

#SettingsHeaderTitle {
    color: #f9e2af;
    font-size: 12pt;
    font-weight: bold;
}

#SettingsHeaderSubtitle {
    color: #a6adc8;
    font-size: 9pt;
}

#SettingsCloseBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

#SettingsCloseBtn:hover {
    background: rgba(243, 139, 168, 0.25);
}

#ModelCard {
    background-color: rgba(30, 35, 45, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
}

#ModelCard:hover {
    border: 1px solid rgba(249, 226, 175, 0.35);
}

#CardTitle {
    color: #cdd6f4;
    font-size: 10pt;
    font-weight: bold;
}

#PriorityBadge {
    font-size: 8.5pt;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
}

#CardFieldLabel {
    color: #a6adc8;
    font-size: 9pt;
}

#CardArrowBtn, #EyeToggleBtn, #CardDeleteBtn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    padding: 2px;
}

#CardArrowBtn:hover, #EyeToggleBtn:hover {
    background: rgba(249, 226, 175, 0.20);
    border-color: rgba(249, 226, 175, 0.40);
}

#CardDeleteBtn:hover {
    background: rgba(243, 139, 168, 0.25);
    border-color: rgba(243, 139, 168, 0.50);
}

#CardDeleteBtn:disabled {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.04);
}

#CardNameInput {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 6px;
    color: #cdd6f4;
    font-size: 10pt;
    font-weight: bold;
}

#CardNameInput:focus, #CardNameInput:hover {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
}

#AddCardBtn {
    background-color: rgba(249, 226, 175, 0.12);
    border: 1px solid rgba(249, 226, 175, 0.35);
    border-radius: 6px;
    padding: 5px 14px;
    color: #f9e2af;
    font-weight: bold;
    font-size: 9.5pt;
}

#AddCardBtn:hover {
    background-color: rgba(249, 226, 175, 0.25);
    border-color: rgba(249, 226, 175, 0.60);
}

#SettingsInput {
    background-color: rgba(17, 17, 27, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9.5pt;
    color: #e6ebf5;
}

#SettingsInput:focus {
    border: 1px solid rgba(137, 180, 250, 0.60);
    background-color: rgba(25, 30, 40, 0.85);
}

#ModelComboBox {
    background-color: rgba(17, 17, 27, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9.5pt;
    color: #e6ebf5;
}

#ModelComboBox:focus {
    border: 1px solid rgba(137, 180, 250, 0.60);
}

#ModelComboBox QAbstractItemView {
    background-color: #1e1e2e;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e6ebf5;
    selection-background-color: rgba(249, 226, 175, 0.25);
    selection-color: #f9e2af;
}

#TestPingBtn {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 3px 10px;
    color: #cdd6f4;
    font-size: 9pt;
}

#TestPingBtn:hover {
    background-color: rgba(249, 226, 175, 0.18);
    border-color: rgba(249, 226, 175, 0.40);
    color: #f9e2af;
}

#TestResultLabel {
    font-size: 9pt;
}

#SettingsCancelBtn {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 6px 14px;
    color: #cdd6f4;
    font-size: 9.5pt;
}

#SettingsCancelBtn:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

#SettingsSaveBtn {
    background-color: #f9e2af;
    color: #11111b;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 9.5pt;
}

#SettingsSaveBtn:hover {
    background-color: #f5c2e7;
}

#SettingsFooterStatus {
    font-size: 9pt;
}

