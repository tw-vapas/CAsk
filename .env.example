# ==============================================================================
# API Configuration for Rofi AI Translator
# Copy this file to ~/.config/rofi-translate/config.env or .env in this folder
# ==============================================================================

# 1. Groq API (Khuyên dùng - Siêu tốc ~0.6s - 1s, Miễn phí: https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# 2. Google Gemini API (Dự phòng fallback - Miễn phí: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
