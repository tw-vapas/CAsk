# ==============================================================================
# API Configuration for Ctrans (Convenient Translation)
# Copy this file to ~/.config/ctrans/config.env or .env in this folder
# ==============================================================================

# 1. Groq API (Recommended - Fast ~0.6s, Free: https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# 2. Google Gemini API (Fallback, Free: https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# 3. Output Generation Limits (Optional)
MAX_TOKENS=4096

# 4. Multi-Turn Follow-Up Limit (Optional, Default: 3, Min: 1, Max: 10)
MAX_FOLLOWUP_TURNS=3

